<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>edu.ucsd.idekerlab</groupId>
  <artifactId>massql-java</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <!-- Plain jar. NOT an OSGi bundle: massql-java must be unable to compile against
       Cytoscape, and that compile-time firewall is the only thing that reliably keeps
       org.cytoscape imports out of engine code (SPIKE.md §1). -->
  <packaging>jar</packaging>

  <name>massql-java</name>
  <description>Pure-Java MassQL SDK (scaninfo subset). Parser, spectra readers, query engine, result model.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- 17 matches Cytoscape 3.10.4's parent pom (DEPENDENCY_POLICY.md constraint 7). -->
    <maven.compiler.release>17</maven.compiler.release>

    <antlr.version>4.13.2</antlr.version>
    <javolution.version>6.11.8</javolution.version>
    <junit.version>5.11.4</junit.version>

    <!-- No slf4j property: the SDK logs NOTHING (constraint 5). slf4j was only ever
         needed by MSDK's MzMLFileImportMethod, and MSDK is no longer a dependency.
         The enforcer bans it outright so it cannot return; note that slf4j 2.x uses
         ServiceLoader, so a future "harmless" logging addition would breach constraint 1
         as well as 5. Return diagnostics to the caller instead. -->
  </properties>

  <dependencies>
    <!-- ================================================================
         RUNTIME CLOSURE IS DELIBERATELY TWO ARTIFACTS.
         Total 785,599 B ~= 0.75 MB, half the ~1.5 MB budget.

         MSDK is NOT a dependency. It is a VENDORING SOURCE (Correction C16).
         msdk-datamodel requires Guava unavoidably — MsScan declares
         `Range<Double> getScanningRange()` in the INTERFACE and SimpleMsScan
         holds a Range field and calls Preconditions, so the classes cannot
         link without it. Guava + its annotation satellites are 2,992,669 B
         (2.85 MB), which took the closure to 3.97 MB, and the real problem
         was not size:

           - Cytoscape exports Guava 9.0.0 (guava-osgi:9.0.0, circa 2011);
             MSDK compiles against 27.1. Importing cannot satisfy that.
           - Guava 27.1 is itself an OSGi bundle exporting com.google.common.*
             at version="27.1.0", so embedding it makes bnd emit
             Import-Package: com.google.common.collect;version="[27.1,28)",
             which Felix tries to satisfy from the runtime, finds Guava 9, and
             FAILS TO RESOLVE unless the imports are explicitly negated.
           - jsr305 rides along exporting javax.annotation (69 classes), a
             known duplicate-exporter conflict source.

         Vendoring both parsers (Tech_Step6 for mzML, Tech_Step7 for mzXML)
         removes all three hazards. MZmine vendored these same parsers, so
         portability is proven by construction.
         ================================================================ -->

    <!-- The ONLY reason this is here: MSDK's parsers instantiate
         javolution.xml.internal.stream.XMLStreamReaderImpl DIRECTLY, and the
         vendored copies keep doing so. That is what avoids the JDK's
         javax.xml.stream.XMLInputFactory, which discovers implementations via
         ServiceLoader — banned by constraint 1 because the thread-context
         classloader cannot see inside an OSGi bundle. Instantiating the JDK's
         internal impl by name instead would need Class.forName, also banned.

         Audited 2026-07-30: 459,292 B, ZERO META-INF/services, ZERO
         META-INF/versions, zero native libs, and a proper OSGi bundle with a
         unique symbolic name (nothing else in Cytoscape provides javolution.*,
         so no split package or version conflict). Its org.osgi.core dependency
         is not compile-scope and does not enter the closure. -->
    <dependency>
      <groupId>com.github.chhh</groupId>
      <artifactId>javolution-core-java-msftbx</artifactId>
      <version>${javolution.version}</version>
    </dependency>

    <!-- Parser runtime: 326,307 B, zero transitive deps, and zero
         ServiceLoader / Class.forName / reflection / Unsafe. -->
    <dependency>
      <groupId>org.antlr</groupId>
      <artifactId>antlr4-runtime</artifactId>
      <version>${antlr.version}</version>
    </dependency>

    <!-- TEST SCOPE ONLY. Must never leak into the artifact massql-app embeds. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <!-- Grammar lives in src/main/antlr4/, NEVER src/main/resources/. Cytoscape app
           poms set <filtering>true</filtering> on resources, and a grammar containing
           ${...} gets silently corrupted — it would compile here and break when the app
           embeds it. Any formatter added later must exclude target/generated-sources/. -->
      <plugin>
        <groupId>org.antlr</groupId>
        <artifactId>antlr4-maven-plugin</artifactId>
        <version>${antlr.version}</version>
        <configuration>
          <visitor>true</visitor>
          <listener>false</listener>
        </configuration>
        <executions>
          <execution>
            <goals><goal>antlr4</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- Fast/slow split: surefire runs *Test.java on `mvn test` (developers expect
           milliseconds); failsafe runs *IT.java on `mvn verify` (what the reviewer runs). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes><include>**/*Test.java</include></includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes><include>**/*IT.java</include></includes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Not a coverage gate. Tech_Step13 maps each SPIKE.md §3 rule to the test that
           pins it; a percentage target would only invite tests written for the number. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals><goal>report</goal></goals>
          </execution>
        </executions>
      </plugin>

      <!-- Turns DEPENDENCY_POLICY.md from prose into a failing build. Without this the
           policy is a document nobody re-reads before adding a dependency. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>dependency-policy</id>
            <phase>validate</phase>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <!-- MSDK is a VENDORING SOURCE, never a dependency (C1, C16). Both
                         parsers are vendored; depending on any MSDK artifact would drag
                         Guava back via msdk-datamodel. -->
                    <exclude>io.github.msdk:*</exclude>
                    <exclude>it.unimi.dsi:dsiutils</exclude>
                    <exclude>it.unimi.dsi:fastutil</exclude>
                    <exclude>com.google.guava:guava</exclude>
                    <!-- Guava's annotation satellites. jsr305 exports javax.annotation
                         (69 classes) — a duplicate-exporter conflict source in OSGi. -->
                    <exclude>com.google.code.findbugs:jsr305</exclude>
                    <exclude>org.checkerframework:checker-qual</exclude>
                    <exclude>com.google.errorprone:error_prone_annotations</exclude>
                    <exclude>com.google.j2objc:j2objc-annotations</exclude>
                    <!-- constraint 5: no logging framework beyond the pinned slf4j-api -->
                    <exclude>ch.qos.logback:*</exclude>
                    <exclude>org.slf4j:slf4j-simple</exclude>
                    <exclude>org.slf4j:slf4j-log4j12</exclude>
                    <exclude>org.slf4j:slf4j-reload4j</exclude>
                    <!-- constraint 3: no JAXB -->
                    <exclude>javax.xml.bind:*</exclude>
                    <exclude>com.sun.xml.bind:*</exclude>
                    <exclude>jakarta.xml.bind:*</exclude>
                    <!-- out of scope, and CDK is 2.7 MB with Guava underneath -->
                    <exclude>org.openscience.cdk:*</exclude>
                    <!-- constraint 5: the SDK logs nothing at all, so no slf4j in any
                         form. (2.x would also breach constraint 1 via ServiceLoader.) -->
                    <exclude>org.slf4j:*</exclude>
                  </excludes>
                </bannedDependencies>
                <requireUpperBoundDeps/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <!-- Deploy target for .github/workflows/release.yml. Matches cy-ndex-2 and the other
       Cytoscape repos, so massql-app resolves this artifact with no extra repo config
       (settled decision 4). The <id> values must match the <server> ids in the CI
       settings.xml that supplies REPO_USER / REPO_PWD. -->
  <distributionManagement>
    <repository>
      <id>cytoscape_releases</id>
      <name>Cytoscape Releases</name>
      <url>https://nrnb-nexus.ucsd.edu/repository/cytoscape_releases/</url>
    </repository>
    <snapshotRepository>
      <id>cytoscape_snapshots</id>
      <name>Cytoscape Snapshots</name>
      <url>https://nrnb-nexus.ucsd.edu/repository/cytoscape_snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

</project>
